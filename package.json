{
  "name": "peelvision-ai",
  "version": "2.1.0",
  "description": "Smart Onion Quality Assessment & Disease Diagnostic Platform for SIH 2026",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "node scripts/build.js",
    "build:frontend": "node scripts/build.js",
    "build:backend": "npm --prefix backend run build",
    "vercel-build": "node scripts/build.js",
    "test": "npm --prefix backend test && npm --prefix frontend test",
    "test:backend": "npm --prefix backend test",
    "test:frontend": "npm --prefix frontend test",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "author": "PeelVision AI Team",
  "license": "MIT"
}
