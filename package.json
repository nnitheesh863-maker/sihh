{
  "name": "sih26031-onion-quality-system",
  "version": "1.0.0",
  "description": "AI-Powered Onion Quality Assessment & Grading System for Smart India Hackathon 2026",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --workspace=sih26031-backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build:frontend",
    "build:backend": "npm run build --workspace=sih26031-backend",
    "build:frontend": "npm run build --workspace=frontend",
    "vercel-build": "npm run build --workspace=frontend",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "npm test --workspace=sih26031-backend",
    "test:frontend": "npm test --workspace=frontend",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "author": "SIH Team",
  "license": "MIT"
}
